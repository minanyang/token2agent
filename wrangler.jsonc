{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "token2agent",
	"compatibility_date": "2026-11-01",
	// The Astro build output, behind a small Worker that sends non-Chinese browsers to /en/ and serves Markdown to
	// agents that ask for it (worker/index.ts).
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// The Worker needs every page in both locales; build assets are served directly.
		"run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*"]
	},
	"routes": [{ "pattern": "token2agent.com", "custom_domain": true }],
	// Required by `wrangler preview`, the deploy command Workers Builds runs for non-production branches.
	"previews": {}
}
