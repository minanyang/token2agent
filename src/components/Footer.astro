---
// Wraps Starlight's footer to add the license notice under every page.
import Default from '@astrojs/starlight/components/Footer.astro';
import { t } from '../i18n';

const strings = t(Astro.locals.starlightRoute.lang);
---

<Default />
<p class="license" set:html={strings.license} />

<style>
	.license {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.license a {
		color: inherit;
	}
</style>
