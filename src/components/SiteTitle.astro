---
// Header title: the brand name always, the descriptive part (after 「：」) only when there is room.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const [brand, ...rest] = siteTitle.split('：');
const subtitle = rest.join('：');
---

<a href={siteTitleHref} class="site-title" translate="no">
	<img src="/favicon.svg" alt="" width="28" height="28" />
	<span>{brand}{subtitle && <span class="subtitle">：{subtitle}</span>}</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
		gap: 0.5rem;
	}
	img {
		flex-shrink: 0;
	}
	@media (max-width: 50rem) {
		.subtitle {
			display: none;
		}
	}
</style>
