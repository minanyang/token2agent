---
// Header title: the brand name always, the descriptive part (after 「：」) only when there is room.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const [brand, ...rest] = siteTitle.split('：');
const subtitle = rest.join('：');
---

<a href={siteTitleHref} class="site-title" translate="no">
	<img src="/favicon.svg" alt="" width="28" height="28" />
	<span>{brand}{subtitle && <span class="subtitle">：{subtitle}</span>}</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-h4);
		font-weight: 600;
		letter-spacing: -0.02em;
		/* Neutral, so the logo is the only color in the header. */
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
		gap: 0.5rem;
	}
	img {
		flex-shrink: 0;
	}
	@media (max-width: 50rem) {
		.subtitle {
			display: none;
		}
	}
</style>
