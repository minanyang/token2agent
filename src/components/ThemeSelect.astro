---
// Replaces Starlight's three-way theme picker with a single light/dark toggle, next to the reading-depth toggle.
// Simple mode collapses `<details class="deep">` blocks and hides `<section class="deep-section">` bodies (styles in src/styles/custom.css);
// deep mode expands and shows them all.
import { Icon } from '@astrojs/starlight/components';
---

<div class="controls">
	<div class="depth-toggle" role="group" aria-label="閱讀模式">
		<button type="button" data-depth="simple" aria-pressed="true">淺顯</button>
		<button type="button" data-depth="deep" aria-pressed="false">深入</button>
	</div>
	<button type="button" class="theme-toggle" aria-label="切換成深色">
		<Icon name="moon" class="to-dark" />
		<Icon name="sun" class="to-light" />
	</button>
</div>

{/* Inlined so deep sections are shown before first paint when the reader chose 深入. */}
<script is:inline>
	try {
		if (localStorage.getItem('token2agent-depth') === 'deep') document.documentElement.dataset.depth = 'deep';
	} catch {}
</script>

<script>
	type Depth = 'simple' | 'deep';
	const storageKey = 'token2agent-depth';

	const load = (): Depth => {
		try {
			return localStorage.getItem(storageKey) === 'deep' ? 'deep' : 'simple';
		} catch {
			return 'simple';
		}
	};

	function apply(depth: Depth): void {
		document.documentElement.dataset.depth = depth;
		for (const el of document.querySelectorAll<HTMLDetailsElement>('details.deep')) {
			el.open = depth === 'deep';
		}
		for (const button of document.querySelectorAll<HTMLButtonElement>('.depth-toggle button')) {
			button.setAttribute('aria-pressed', String(button.dataset.depth === depth));
		}
	}

	function choose(depth: Depth): void {
		try {
			localStorage.setItem(storageKey, depth);
		} catch {
			// Storage can be unavailable (private mode); the choice then lasts for this page only.
		}
		apply(depth);
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('.depth-toggle button')) {
		button.addEventListener('click', () => choose(button.dataset.depth === 'deep' ? 'deep' : 'simple'));
	}
	// Each deep section keeps its heading visible in 淺顯 mode; its notice button opens just that section.
	for (const section of document.querySelectorAll('.deep-section')) {
		const notice = document.createElement('p');
		notice.className = 'deep-notice';
		notice.textContent = '這部分是選讀或進階內容。';
		const button = document.createElement('button');
		button.type = 'button';
		button.textContent = '展開這一段';
		button.setAttribute('aria-expanded', 'false');
		button.addEventListener('click', () => {
			const open = section.classList.toggle('is-open');
			button.textContent = open ? '收起這一段' : '展開這一段';
			button.setAttribute('aria-expanded', String(open));
		});
		notice.append(button);
		section.firstElementChild?.after(notice);
	}

	apply(load());

	// Theme: Starlight's ThemeProvider sets data-theme before paint (stored choice, else the system setting).
	// The toggle stores an explicit choice under Starlight's key; with no stored choice, follow the system.
	const themeKey = 'starlight-theme';
	const currentTheme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
	const syncThemeButtons = () => {
		const label = currentTheme() === 'light' ? '切換成深色' : '切換成淺色';
		for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
			button.setAttribute('aria-label', label);
			button.title = label;
		}
	};
	for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
		button.addEventListener('click', () => {
			const next = currentTheme() === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem(themeKey, next);
			} catch {
				// Storage unavailable: the choice lasts for this page only.
			}
			syncThemeButtons();
		});
	}
	matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
		let stored: string | null = null;
		try {
			stored = localStorage.getItem(themeKey);
		} catch {}
		if (stored === 'light' || stored === 'dark') return;
		document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
		syncThemeButtons();
	});
	syncThemeButtons();
</script>

<style>
	.controls {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s;
	}
	.theme-toggle:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}
	.theme-toggle :global(svg) {
		grid-area: 1 / 1;
		font-size: 1.1rem;
		transition:
			transform 0.3s ease,
			opacity 0.2s;
	}
	/* Show the icon of the theme the click switches to. */
	:global([data-theme='light']) .theme-toggle :global(.to-light),
	:global([data-theme='dark']) .theme-toggle :global(.to-dark) {
		opacity: 0;
		transform: rotate(-90deg) scale(0.5);
	}
	@media (prefers-reduced-motion: reduce) {
		.theme-toggle :global(svg) {
			transition: none;
		}
	}
	.depth-toggle {
		display: inline-flex;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		padding: 2px;
	}
	.depth-toggle button {
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.15rem 0.7rem;
		border-radius: 999px;
		cursor: pointer;
		white-space: nowrap;
	}
	.depth-toggle button[aria-pressed='true'] {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		font-weight: 600;
	}
</style>
