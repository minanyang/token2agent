---
// Adds schema.org JSON-LD (course, stage pages as its parts, breadcrumbs) to Starlight's default head.
import Default from '@astrojs/starlight/components/Head.astro';
import { getStageEntries, localizePath, t, toLang } from '../i18n';

const site = 'https://token2agent.com';
const route = Astro.locals.starlightRoute;
const lang = toLang(route.lang);
const socialImage = `${site}/${lang === 'en' ? 'og-en.png' : 'og.png'}`;
const home = `${site}${localizePath(lang, '/')}`;
const { title, description } = route.entry.data;
const url = new URL(Astro.url.pathname, site).href;

const course = {
	'@type': 'Course',
	'@id': `${home}#course`,
	name: t(lang).siteName,
	url: home,
	inLanguage: lang,
	isAccessibleForFree: true,
	license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
	author: { '@type': 'Person', name: 'Min-An Yang', url: 'https://github.com/minanyang' },
};

const stageMatch = route.id.match(/^(?:en\/)?stages\/s(\d+)-/);
const graph: Record<string, unknown>[] = [];

if (route.id === '' || route.id === 'en') {
	const stages = await getStageEntries(lang);
	graph.push(
		{ '@type': 'WebSite', '@id': `${home}#website`, name: 'Token2Agent', url: home, inLanguage: lang },
		{
			...course,
			description,
			hasPart: stages.map(({ entry, href }, i) => ({
				'@type': 'LearningResource',
				name: entry.data.title,
				url: `${site}${href}`,
				position: i + 1,
			})),
		},
	);
} else {
	if (stageMatch) {
		graph.push({
			'@type': 'LearningResource',
			name: title,
			description,
			url,
			inLanguage: lang,
			learningResourceType: 'Lecture',
			isAccessibleForFree: true,
			license: course.license,
			position: Number(stageMatch[1]) + 1,
			isPartOf: { '@id': course['@id'] },
		});
	}
	graph.push({
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Token2Agent', item: home },
			{ '@type': 'ListItem', position: 2, name: title, item: url },
		],
	});
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<Default />
<meta property="og:image" content={socialImage} />
<meta name="twitter:image" content={socialImage} />
<meta property="og:image:alt" content={t(lang).siteName} />
<script type="application/ld+json" set:html={jsonLd} />
