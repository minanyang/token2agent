---
// Adds schema.org JSON-LD (course, stage pages as its parts, breadcrumbs) to Starlight's default head.
import Default from '@astrojs/starlight/components/Head.astro';
import { getCollection } from 'astro:content';

const site = 'https://token2agent.com';
const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;
const url = new URL(Astro.url.pathname, site).href;

const course = {
	'@type': 'Course',
	'@id': `${site}/#course`,
	name: 'Token2Agent：從 token 到 agent 的 AI/LLM 學習路線',
	url: `${site}/`,
	inLanguage: 'zh-TW',
	isAccessibleForFree: true,
	license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
	author: { '@type': 'Person', name: 'Min-An Yang', url: 'https://github.com/minanyang' },
};

const stageMatch = route.id.match(/^stages\/s(\d+)-/);
const graph: Record<string, unknown>[] = [];

if (route.id === '') {
	const stages = (await getCollection('docs', (e) => e.id.startsWith('stages/'))).sort((a, b) =>
		a.id.localeCompare(b.id),
	);
	graph.push(
		{ '@type': 'WebSite', '@id': `${site}/#website`, name: 'Token2Agent', url: `${site}/`, inLanguage: 'zh-TW' },
		{
			...course,
			description,
			hasPart: stages.map((e, i) => ({
				'@type': 'LearningResource',
				name: e.data.title,
				url: `${site}/${e.id}/`,
				position: i + 1,
			})),
		},
	);
} else {
	if (stageMatch) {
		graph.push({
			'@type': 'LearningResource',
			name: title,
			description,
			url,
			inLanguage: 'zh-TW',
			learningResourceType: 'Lecture',
			isAccessibleForFree: true,
			license: course.license,
			position: Number(stageMatch[1]) + 1,
			isPartOf: { '@id': course['@id'] },
		});
	}
	graph.push({
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Token2Agent', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: title, item: url },
		],
	});
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<Default />
<script type="application/ld+json" set:html={jsonLd} />
