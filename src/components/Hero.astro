---
// Home hero: the title and tagline rendered as real tokens (left) next to an agent run log (right),
// i.e. the site's name drawn literally: tokens → agent.
// Tokens come from o200k_base (GPT-4o's tokenizer, public); Claude's tokenizer is not public.
import { getEncoding } from 'js-tiktoken';
import { LinkButton } from '@astrojs/starlight/components';
import { stageCount } from '../data/parts';

// Starlight's skip link targets this id (PAGE_TITLE_ID, not exported).
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline = '', actions = [] } = data.hero || {};

type Token = { text: string; ids: number[] };

const enc = getEncoding('o200k_base');

// Byte-level BPE can split one CJK character across tokens; merge those so every chip is readable text.
function tokenize(text: string): Token[] {
	const out: Token[] = [];
	let ids: number[] = [];
	for (const id of enc.encode(text)) {
		ids.push(id);
		const piece = enc.decode(ids);
		if (!piece.includes('�')) {
			out.push({ text: piece, ids });
			ids = [];
		}
	}
	return out;
}

const titleTokens = tokenize(title);
// Only the first tagline line is tokenized; the rest stays plain text so the hero doesn't get noisy.
const [taglineFirst = '', ...taglineRest] = tagline.split(/<br\s*\/?>/).map((line) => line.trim());
const taglineLines = [tokenize(taglineFirst)];
// Running index so the load animation streams title then tagline in order.
const lineOffsets = taglineLines.map((_, li) => titleTokens.length + taglineLines.slice(0, li).flat().length);
const tokenCount = [titleTokens, ...taglineLines].flat().reduce((n, t) => n + t.ids.length, 0);

// `stage`: the chapter the run has reached at this step (drives the progress strip below the log).
const runLog = [
	{ kind: 'plan', text: '20 章、7 個 Part；應用路線從 S0 直接接到 S6' },
	{ kind: 'tool', text: 'read("S0 全局地圖")', stage: 0 },
	{ kind: 'observe', text: '看懂 token、模型、應用、agent 怎麼接起來', stage: 0 },
	{ kind: 'tool', text: 'build("A6 串流聊天介面與 trace")', stage: 6 },
	{ kind: 'tool', text: 'build("A9 附引用的 RAG")', stage: 9 },
	{ kind: 'tool', text: 'build("A12 手寫 harness")', stage: 12 },
	{ kind: 'tool', text: 'build("A18 多使用者部署")', stage: 18 },
	{ kind: 'done', text: '一個已部署上線、自己每天在用的 agent', stage: 19 },
];

// Progress strip: one block per chapter. Each block lights up at the first step that reaches it.
const lastStage = stageCount - 1;
const blocks = Array.from({ length: stageCount }, (_, i) => ({
	step: runLog.findIndex((l) => l.stage !== undefined && l.stage >= i),
}));
// Label shown from the step where the stage changes until the next change.
const labelSteps = runLog
	.map((l, i) => ({ stage: l.stage, step: i }))
	.filter((l, i, all) => l.stage !== undefined && l.stage !== all[i - 1]?.stage);
const labels = labelSteps.map((l, i) => ({ ...l, next: labelSteps[i + 1]?.step }));
---

<div class="hero t2a-hero">
	<div class="copy">
		<h1 id={PAGE_TITLE_ID} data-page-title aria-label={title}>
			{titleTokens.map((t, i) => <span class="tok" style={`--i:${i}`} data-ids={t.ids.join(' + ')} aria-hidden="true">{t.text}</span>)}
		</h1>
		<p class="tagline" aria-label={taglineFirst}>
			{taglineLines.map((line, li) => (
				<span class="line" aria-hidden="true">
					{line.map((t, i) => <span class="tok" style={`--i:${lineOffsets[li] + i}`} data-ids={t.ids.join(' + ')}>{t.text}</span>)}
				</span>
			))}
		</p>
		{taglineRest.length > 0 && <p class="tagline-rest">{taglineRest.join(' ')}</p>}
		<p class="tok-meta">
			<span><b>{tokenCount}</b> tokens</span>
			<span>o200k_base tokenizer · 游標指著看 token id</span>
		</p>
		{actions.length > 0 && (
			<div class="actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)}
	</div>

	<figure class="run" aria-label="把這份路線當成一次 agent 執行">
		<figcaption>
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<span>token2agent — agent run</span>
		</figcaption>
		<p class="prompt"><span class="ps" aria-hidden="true">$</span> agent run --goal "做出能上線的 AI 應用與 agent"</p>
		<ol>
			{runLog.map((l, i) => (
				<li style={`--i:${i}`}>
					<span class:list={['kind', l.kind]}>{l.kind}</span>
					<span class="text">{l.text}</span>
				</li>
			))}
		</ol>
		<p class="prompt next" style={`--i:${runLog.length}`} aria-hidden="true"><span class="ps">$</span> <span class="cursor"></span></p>
		<div class="progress" role="img" aria-label={`進度：S0 到 S${lastStage}`}>
			<p class="progress-label" aria-hidden="true">
				<span>progress</span>
				<span class="steps">
					{labels.map((l) => (
						<b class:list={['step', { final: l.next === undefined }]} style={`--k:${l.step};--next:${l.next ?? 0}`}>
							S{l.stage} / S{lastStage}
						</b>
					))}
				</span>
			</p>
			<div class="strip" aria-hidden="true">
				{blocks.map((b, i) => <i class="blk" style={`--k:${b.step}`} title={`S${i}`} />)}
			</div>
		</div>
	</figure>
</div>

<style>
	.t2a-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		align-items: center;
		padding-block: 1.5rem 1rem;
	}
	@media (min-width: 64rem) {
		.t2a-hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			/* Top-aligned: the title and the terminal's title bar share one top edge. */
			align-items: start;
			gap: 3rem;
			padding-block: 3.5rem 1.45rem;
		}
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}

	/* Token chips. --tok-* colors are defined in src/styles/custom.css for both themes. */
	.tok {
		position: relative;
		white-space: pre;
		border-radius: 0.2em;
		background: var(--c);
		color: var(--sl-color-white);
		--c: var(--tok-1);
	}
	.tok:nth-child(6n + 2) { --c: var(--tok-2); }
	.tok:nth-child(6n + 3) { --c: var(--tok-3); }
	.tok:nth-child(6n + 4) { --c: var(--tok-4); }
	.tok:nth-child(6n + 5) { --c: var(--tok-5); }
	.tok:nth-child(6n + 6) { --c: var(--tok-6); }
	.tok:hover::after {
		content: 'id ' attr(data-ids);
		position: absolute;
		left: 50%;
		bottom: calc(100% + 0.3rem);
		transform: translateX(-50%);
		padding: 0.05rem 0.4rem;
		border-radius: 0.25rem;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font: 500 0.75rem/1.5 var(--__sl-font-mono);
		letter-spacing: 0;
		white-space: nowrap;
		z-index: 2;
	}

	h1 {
		display: flex;
		flex-wrap: wrap;
		gap: 0.08em;
		margin: 0;
		font: 700 clamp(2.5rem, 1rem + 5vw, 4.25rem) / 1.1 var(--__sl-font-mono);
		letter-spacing: -0.03em;
	}
	h1 .tok {
		padding: 0.02em 0.14em;
		border-radius: 0.14em;
	}
	.tagline {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		font-size: clamp(var(--sl-text-base), 0.5rem + 1.2vw, var(--sl-text-xl));
		line-height: 1.9;
		color: var(--sl-color-white);
	}
	.tagline .tok {
		padding-inline: 0.05em;
		box-decoration-break: clone;
	}
	.tagline-rest {
		margin: 0;
		max-width: 34em;
		color: var(--sl-color-gray-2);
	}
	.tok-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		font: var(--sl-text-xs) var(--__sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.tok-meta b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		margin-top: 0.5rem;
	}

	/*
	 * Run log, drawn as a terminal. It keeps one dark palette in both site themes, like a real terminal
	 * window on the page; colors are local tokens so nothing here depends on the site theme.
	 */
	.run {
		--term-bg: #15171c;
		--term-bar: #1d2026;
		--term-line: #2b2f37;
		--term-fg: #e4e6ea;
		--term-muted: #8a909b;
		--term-amber: #f0a33a;
		--term-green: #5fd38d;
		--term-blue: #8ab4ff;
		margin: 0;
		border: 1px solid var(--term-line);
		border-radius: 0.6rem;
		background: var(--term-bg);
		color: var(--term-fg);
		font: var(--sl-text-sm) / 1.65 var(--__sl-font-mono);
		overflow: hidden;
		min-width: 0;
		box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.55);
	}
	figcaption {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		padding: 0.45rem 0.9rem;
		border-bottom: 1px solid var(--term-line);
		background: var(--term-bar);
		font-size: var(--sl-text-xs);
		color: var(--term-muted);
		text-align: center;
	}
	/* Mirror the dots' width on the right so the title stays centered. */
	figcaption::after {
		content: '';
		width: 2.6rem;
	}
	.dots {
		display: flex;
		gap: 0.35rem;
		width: 2.6rem;
	}
	.dots i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #ff5f57;
	}
	.dots i:nth-child(2) {
		background: #febc2e;
	}
	.dots i:nth-child(3) {
		background: #28c840;
	}
	.prompt {
		margin: 0;
		padding: 0.6rem 0.9rem 0;
		color: var(--term-fg);
		white-space: nowrap;
		overflow-x: auto;
	}
	.prompt.next {
		padding: 0 0.9rem 0.6rem;
	}
	.ps {
		color: var(--term-green);
	}
	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		vertical-align: -0.2em;
		background: var(--term-fg);
	}
	ol {
		margin: 0;
		padding: 0.3rem 0.9rem;
		list-style: none;
		overflow-x: auto;
	}
	li {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 0.75rem;
		margin: 0;
		white-space: nowrap;
	}
	@media (max-width: 40rem) {
		li,
		.prompt {
			white-space: normal;
		}
	}
	.kind { color: var(--term-muted); }
	.kind.plan { color: var(--term-blue); }
	.kind.tool { color: var(--term-amber); }
	.kind.observe { color: var(--term-green); }
	.kind.done { color: var(--term-green); font-weight: 700; }
	.text { color: var(--term-fg); }
	/* Progress strip. The static styles are the finished run; the load sequence below animates toward it. */
	.progress {
		display: grid;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem 0.8rem;
		border-top: 1px solid var(--term-line);
	}
	.progress-label {
		display: flex;
		justify-content: space-between;
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--term-muted);
	}
	.steps {
		display: grid;
	}
	.step {
		grid-area: 1 / 1;
		justify-self: end;
		color: var(--term-fg);
		font-variant-numeric: tabular-nums;
		opacity: 0;
	}
	.step.final {
		opacity: 1;
	}
	.strip {
		display: flex;
		gap: 3px;
	}
	.blk {
		flex: 1;
		height: 0.65rem;
		border-radius: 0.15rem;
		background: var(--term-amber);
	}

	/*
	 * Load sequence: tokens stream in, then the run log steps appear and the progress strip follows them.
	 * Step k starts at --base + k × 140ms; replays (see script) drop the initial wait for the title tokens.
	 * Content and the finished state are in the HTML either way.
	 */
	.run {
		--base: 600ms;
	}
	.run.replay {
		--base: 0ms;
	}
	@media (prefers-reduced-motion: no-preference) {
		.tok {
			animation: tok-in 0.25s both;
			animation-delay: calc(var(--i) * 45ms);
		}
		li,
		.prompt.next {
			animation: tok-in 0.3s both;
			animation-delay: calc(var(--base) + var(--i) * 140ms);
		}
		.cursor {
			animation: blink 1s steps(1) infinite;
		}
		.blk {
			animation: blk-fill 0.2s both;
			animation-delay: calc(var(--base) + var(--k) * 140ms);
		}
		/* Each label shows from its step until the next label's step; the last one stays. */
		.step {
			animation:
				step-show 1ms both,
				step-hide 1ms forwards;
			animation-delay: calc(var(--base) + var(--k) * 140ms), calc(var(--base) + var(--next) * 140ms);
		}
		.step.final {
			animation: step-show 1ms both;
			animation-delay: calc(var(--base) + var(--k) * 140ms);
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@keyframes blk-fill {
		from {
			background: var(--term-line);
		}
	}
	@keyframes step-show {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@keyframes step-hide {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}
	@keyframes tok-in {
		from {
			opacity: 0;
			transform: translateY(0.15em);
		}
	}
</style>

<script>
	// Replay the run log every so often, like a new run starting. Paused while the tab is hidden.
	const REPLAY_MS = 10_000;
	const run = document.querySelector<HTMLElement>('.t2a-hero .run');
	if (run && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		setInterval(() => {
			if (document.hidden) return;
			// Replays skip the initial wait for the title tokens (see .run.replay in the styles).
			run.classList.add('replay');
			// Toggling classes does not restart a finished CSS animation; restart each one explicitly
			// (log lines, progress blocks and labels).
			for (const animation of run.getAnimations({ subtree: true })) {
				animation.cancel();
				animation.play();
			}
		}, REPLAY_MS);
	}
</script>
